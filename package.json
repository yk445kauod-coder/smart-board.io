{
  "name": "smartboard-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:data && npm run test:ai && npm run test:lab && npm run test:toolkit && npm run test:edge",
    "test:data": "tsx tests/data-smoke.test.ts",
    "test:ai": "tsx --import ./tests/dom-shims.ts tests/ai-agent.test.ts",
    "test:lab": "tsx --import ./tests/dom-shims.ts tests/lab-smoke.test.ts",
    "test:toolkit": "tsx --import ./tests/dom-shims.ts tests/classroom-toolkit.test.ts",
    "test:edge": "tsx --import ./tests/dom-shims.ts tests/edge-cases.test.ts",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:dry": "npm run build && wrangler pages deploy dist --dry-run"
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.14",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^4.10.38",
    "perfect-freehand": "^1.2.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-simple-maps": "^5.0.5",
    "reactflow": "^11.11.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.131.1"
  }
}
