{
  "name": "smartboard-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.api.json --noEmit && tsc -p tsconfig.legacy.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm e2e",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts && tsx db/extra.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "api:dev": "wrangler dev --config wrangler-api.toml --port 8787",
    "api:deploy": "wrangler deploy --config wrangler-api.toml",
    "pages:deploy": "wrangler pages deploy dist --project-name smartboard-eg",
    "deploy": "pnpm verify && pnpm build && pnpm pages:deploy",
    "neon:env": "neon env pull",
    "test:legacy": "pnpm test:legacy:data && pnpm test:legacy:ai && pnpm test:legacy:lab && pnpm test:legacy:toolkit && pnpm test:legacy:edge && pnpm test:legacy:protocol && pnpm test:legacy:auth && pnpm test:legacy:push",
    "test:legacy:data": "tsx tests/data-smoke.test.ts",
    "test:legacy:ai": "tsx --import ./tests/dom-shims.ts tests/ai-agent.test.ts",
    "test:legacy:lab": "tsx --import ./tests/dom-shims.ts tests/lab-smoke.test.ts",
    "test:legacy:toolkit": "tsx --import ./tests/dom-shims.ts tests/classroom-toolkit.test.ts",
    "test:legacy:edge": "tsx --import ./tests/dom-shims.ts tests/edge-cases.test.ts",
    "test:legacy:protocol": "tsx tests/protocol.test.ts",
    "test:legacy:auth": "tsx tests/auth.test.ts",
    "test:legacy:push": "tsx tests/push.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.8",
    "@neon/env": "^2.1.11",
    "@neon/realtime": "^0.2.2",
    "@neondatabase/serverless": "^1.2.2",
    "@types/dompurify": "^3.0.5",
    "aws4fetch": "^1.0.20",
    "dompurify": "^3.4.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.23",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.4",
    "jose": "^6.2.18",
    "jspdf": "^4.2.1",
    "konva": "^10.11.0",
    "pdfjs-dist": "^4.10.38",
    "perfect-freehand": "^1.2.2",
    "pg": "^8.23.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-konva": "^19.3.2",
    "react-router-dom": "^7.18.7",
    "react-simple-maps": "^5.0.5",
    "reactflow": "^11.11.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.2.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.131.1"
  }
}
