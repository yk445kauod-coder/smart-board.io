# Copy to worker/.dev.vars and fill in. Never commit .dev.vars.
# Local overrides for the production values committed in wrangler.toml.
APP_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
PLATFORM_ADMIN_EMAILS=teacher@example.com

OPENROUTER_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
POLLINATIONS_API_KEY=

# Optional: self-hosted FreeLLMAPI gateway (OpenAI-compatible).
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto

# Optional: Stripe (manual InstaPay / wallet / bank transfer works without it).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCHOOL=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# Keep the private key as a Worker secret; the public key is served to the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@smartboard.ai
