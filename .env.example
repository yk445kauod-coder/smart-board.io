# SmartBoard AI — frontend environment template
# Copy to .env and fill with your real values. Never commit .env.
#
# Leave empty to use same-origin `/api` (Vite proxy in dev, route in production).
VITE_API_BASE=

# Legacy Pages Functions / shared AI routes.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENROUTER_API_KEY=
POLLINATIONS_API_KEY=
GEMINI_API_KEY=
